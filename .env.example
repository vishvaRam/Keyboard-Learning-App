# Copy to .env and adjust. All values optional - defaults live in app/config/settings.py
APP_NAME=Feel Piano
DEBUG=true
HOST=127.0.0.1
PORT=4567

# Session scoring
TARGET_TOLERANCE_MS=120        # how far before/after a note you may hit it
WEAK_VELOCITY_MAX=45           # below this a hit counts as "too soft"
STRONG_VELOCITY_MIN=110        # above this a hit counts as "too loud"
DEFAULT_GHOST_FLOOR=12         # anything quieter/less pressed than this = "ghost note" penalty
ROLLING_WINDOW_SECONDS=20      # how much history the dynamic-consistency score keeps
